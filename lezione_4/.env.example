# Indirizzo del server LM Studio (API compatibile OpenAI), con /v1
LM_BASE_URL=http://localhost:1234/v1
# Identificativo del modello come restituito da GET /v1/models
LM_MODEL=qwen/qwen3.5-9b
# Numero massimo di passaggi modello -> strumenti per ogni domanda
MAX_TOOL_STEPS=3
# Livello dei log su stderr: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Ambito dell'assistente, descritto in italiano
AMBITO_ASSISTENTE=Orari e fusi orari, conversioni di unità di misura, calcoli aritmetici, date, giorni lavorativi, festività e scadenze; anche saluti, ringraziamenti e domande su cosa sa fare l'assistente, e domande su ciò che l'utente ha detto nella conversazione, come il suo nome o le sue preferenze.
# Risposta fissa data alle richieste fuori ambito
MESSAGGIO_RIFIUTO=Mi dispiace, posso aiutarti solo con orari, conversioni, calcoli e scadenze.
# Numero massimo di revisioni della risposta da parte del revisore (predefinito 3; 0 = il revisore giudica una volta ma non rimanda mai all'agente)
MAX_REVISIONI=3
# Riassunto della cronologia vecchia (predefiniti: token, 5000, 3)
# RIASSUNTO_SOGLIA_TIPO=token      # messaggi oppure token
# RIASSUNTO_SOGLIA=5000            # intero >= 1: messaggi o token oltre cui riassumere
# RIASSUNTO_TURNI_DA_TENERE=3      # intero >= 1: turni recenti lasciati intatti
# Per vedere la compressione in fretta (prove): RIASSUNTO_SOGLIA_TIPO=messaggi, RIASSUNTO_SOGLIA=10, RIASSUNTO_TURNI_DA_TENERE=2
