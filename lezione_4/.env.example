# Indirizzo del server LM Studio (API compatibile OpenAI), con /v1
LM_BASE_URL=http://localhost:1234/v1
# Identificativo del modello come restituito da GET /v1/models
LM_MODEL=qwen/qwen3.5-9b
# Numero massimo di passaggi modello -> strumenti per ogni domanda
MAX_TOOL_STEPS=3
# Livello dei log su stderr: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
