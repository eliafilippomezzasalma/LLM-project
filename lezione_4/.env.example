# Indirizzo del server LM Studio (API compatibile OpenAI), con /v1
LM_BASE_URL=http://localhost:1234/v1
# Identificativo del modello come restituito da GET /v1/models
LM_MODEL=qwen/qwen3.5-9b
# Numero massimo di passaggi modello -> strumenti per ogni domanda
MAX_TOOL_STEPS=3
# Livello dei log su stderr: DEBUG, INFO, WARNING
LOG_LEVEL=INFO
# Ambito dell'assistente, descritto in italiano
AMBITO_ASSISTENTE=Orari e fusi orari, conversioni di unità di misura, calcoli aritmetici, date, giorni lavorativi, festività e scadenze; anche saluti, ringraziamenti e domande su cosa sa fare l'assistente.
# Risposta fissa data alle richieste fuori ambito
MESSAGGIO_RIFIUTO=Mi dispiace, posso aiutarti solo con orari, conversioni, calcoli e scadenze.
